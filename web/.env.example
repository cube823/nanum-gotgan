# 복사해서 .env.local 로. 프로덕션(Vercel)에선 대시보드 Environment Variables에 넣는다.

# ── DB ──────────────────────────────────────────────────────────────────
# 로컬: 아래 그대로. Vercel: Storage → Neon 연결하면 자동 주입 (직접 넣지 않는다)
DATABASE_URL=postgres://localhost:5432/nanum_gotgan

# ── Auth.js ─────────────────────────────────────────────────────────────
# openssl rand -base64 32  — 로컬과 프로덕션 값은 다르게
AUTH_SECRET=change-me
# 로컬만. Vercel에선 넣지 않는다 — 배포 URL을 자동으로 쓴다. 커스텀 도메인을 붙인 뒤에만
# AUTH_URL=https://nanumgotgan.com 으로 명시하고 Redeploy.
AUTH_URL=http://localhost:3000

# 구글: console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트(웹)
#   승인된 리디렉션 URI:  http://localhost:3000/api/auth/callback/google
#                       https://<도메인>/api/auth/callback/google
#   시크릿이 안 맞으면 로그에 invalid_client — 콘솔에서 "보안 비밀번호 추가"로 새로 발급
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 카카오: developers.kakao.com → 앱 → 플랫폼 키 → REST API 키 수정
#   ID = REST API 키, SECRET = 같은 페이지의 클라이언트 시크릿(카카오 로그인, 활성화 ON)
#   리다이렉트 URI도 같은 페이지:  http://localhost:3000/api/auth/callback/kakao
#                              https://<도메인>/api/auth/callback/kakao
#   제품 설정 → 카카오 로그인 → 일반: 상태 ON / 동의항목: 닉네임 필수
#   "사이트 도메인"(JavaScript SDK 도메인)은 서버 사이드 OAuth엔 불필요
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# 이 이메일로 로그인하면 운영자(is_admin). 콤마 구분. 첫 로그인 시점에 찍히므로 로그인 전에 넣는다.
ADMIN_EMAILS=

# ── 사진 저장 ────────────────────────────────────────────────────────────
# 비어 있으면 로컬 public/uploads 에 저장. Vercel: Storage → Blob 연결하면 자동 주입.
# BLOB_READ_WRITE_TOKEN=
